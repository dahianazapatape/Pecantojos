# Copia este archivo a ".env" y completa tus datos reales. El archivo .env NO se sube a Git.

# Servidor SQL Server. En este archivo la barra invertida va SIN duplicar (una sola \).
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=PECANTOJOS
DB_USER=
DB_PASSWORD=

# Solo si NO usas instancia con nombre (ej. DB_SERVER=localhost). Si usas SQLEXPRESS, déjalo comentado.
# DB_PORT=1433

# Puerto del servidor Express
PORT=3000
