                "example": {
                  "id": 21,
                  "nombre_cliente": "Ana Pérez",
                  "telefono": "3001234567",
                  "correo": "ana.perez@gmail.com",
                  "direccion": "Cra 50 #20-10",
                  "ciudad": "Medellín",
                  "fecha_registro": "2026-11-04"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (ADR-005)",
