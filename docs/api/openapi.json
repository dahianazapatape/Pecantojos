    "/pedidos": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Listar pedidos",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "description": "Estado exacto",
            "schema": {
              "type": "string"
            },
            "example": "Pendiente"
          },
          {
            "name": "cliente",
            "in": "query",
            "required": false,
            "description": "Nombre del cliente (contiene)",
            "schema": {
              "type": "string"
            },
            "example": "Laura"
          },
          {
            "name": "fecha_inicio",
            "in": "query",
            "required": false,
            "description": "Desde (AAAA-MM-DD)",
            "schema": {
              "type": "string"
            },
            "example": "2026-04-01"
          },
          {
            "name": "fecha_fin",
            "in": "query",
            "required": false,
            "description": "Hasta (AAAA-MM-DD)",
            "schema": {
              "type": "string"
            },
            "example": "2026-04-30"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pedidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pedido"
                  }
                },
                "example": [
                  {
                    "id": 11,
                    "id_cliente": 1,
                    "fecha_pedido": "2026-11-04",
                    "fecha_entrega": "2026-11-06",
                    "estado_pedido": "Pendiente",
                    "valor_total": 0,
                    "nombre_cliente": "María Fernanda Gómez",
                    "tel_cliente": "3005678123"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Error del servidor o de la base de datos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to connect to localhost:1433"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Crear pedido",
        "description": "id_cliente obligatorio; la fecha de entrega no puede ser anterior a la del pedido (ADR-005).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoEntrada"
              },
              "example": {
                "id_cliente": 1,
                "fecha_entrega": "2026-11-06",
                "estado_pedido": "Pendiente"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pedido"
                },
                "example": {
                  "id": 11,
                  "id_cliente": 1,
                  "fecha_pedido": "2026-11-04",
                  "fecha_entrega": "2026-11-06",
                  "estado_pedido": "Pendiente",
                  "valor_total": 0
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (ADR-005)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Datos inválidos: el nombre del cliente es obligatorio"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor o de la base de datos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to connect to localhost:1433"
                }
              }
            }
          }
        }
      }
