    "/pedidos/{id}/detalle": {
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Agregar un producto al pedido",
        "description": "Flujo principal: valida (ADR-005) y, en una transacción (ADR-003), inserta el detalle, descuenta el stock y recalcula el total.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del recurso",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetalleEntrada"
              },
              "example": {
                "id_producto": 1,
                "cantidad": 2,
                "precio_unitario": 6000
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Producto agregado",
            "content": {
              "application/json": {
                "example": {
                  "message": "Producto agregado y stock actualizado"
                }
              }
            }
          },
          "400": {
            "description": "Dato inválido o stock insuficiente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Stock insuficiente. Disponible: 20"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor o de la base de datos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to connect to localhost:1433"
                }
              }
            }
          }
        }
      }
    },
    "/pedidos/{id}/detalle/{detalleId}": {
      "delete": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Quitar un producto del pedido",
        "description": "Borra el detalle, devuelve el stock y recalcula el total en una transacción (ADR-003).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del recurso",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          },
          {
            "name": "detalleId",
            "in": "path",
            "required": true,
            "description": "Id del detalle",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "responses": {
          "200": {
            "description": "Producto quitado",
            "content": {
              "application/json": {
                "example": {
                  "message": "Producto eliminado y stock devuelto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (ADR-005)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Datos inválidos: el nombre del cliente es obligatorio"
                }
              }
            }
          },
          "404": {
            "description": "Detalle no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Detalle no encontrado"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor o de la base de datos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to connect to localhost:1433"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "usuario": "admin1",
                "password": "********"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "admin": {
                    "id": 1,
                    "usuario": "admin1",
                    "nombre": "Administrador Principal"
                  },
                  "token": "<token>"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Usuario o contraseña incorrectos"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ClienteEntrada": {
        "type": "object",
        "required": [
          "nombre_cliente"
        ],
        "properties": {
          "nombre_cliente": {
            "type": "string"
          },
          "telefono": {
            "type": "string",
            "description": "7 a 20 caracteres: números, espacios, guiones y +"
          },
          "correo": {
            "type": "string",
            "format": "email"
          },
          "direccion": {
            "type": "string"
          },
          "ciudad": {
            "type": "string"
          },
          "fecha_registro": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Cliente": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              }
            }
          },
          {
            "$ref": "#/components/schemas/ClienteEntrada"
          }
        ]
      },
      "PedidoEntrada": {
        "type": "object",
        "required": [
          "id_cliente"
        ],
        "properties": {
          "id_cliente": {
            "type": "integer",
            "minimum": 1
          },
          "fecha_pedido": {
            "type": "string",
            "format": "date"
          },
          "fecha_entrega": {
            "type": "string",
            "format": "date"
          },
          "estado_pedido": {
            "type": "string",
            "example": "Pendiente"
          },
          "valor_total": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "Pedido": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              }
            }
          },
          {
            "$ref": "#/components/schemas/PedidoEntrada"
          }
        ]
      },
      "DetalleEntrada": {
        "type": "object",
        "required": [
          "id_producto",
          "cantidad",
          "precio_unitario"
        ],
        "properties": {
          "id_producto": {
            "type": "integer",
            "minimum": 1
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1
          },
          "precio_unitario": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}