          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del recurso",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "responses": {
          "200": {
            "description": "Dependencias",
            "content": {
              "application/json": {
                "example": {
                  "pedidos": 1,
                  "mensaje": "Este cliente tiene 1 pedido(s) asociado(s). Al eliminarlo se eliminarán también sus pedidos, detalles y pagos."
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (ADR-005)",
            "content": {
