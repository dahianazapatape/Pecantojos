{
  "openapi": "3.0.3",
  "info": {
    "title": "API Pecantojos — Módulo de Pedidos y Clientes",
    "version": "2.0.0",
    "description": "API REST del módulo MVP refactorizado en capas (ADR-001 a ADR-005). Los errores de negocio responden `{\"error\": \"mensaje\"}` con código 400 o 404."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Clientes"
    },
    {
      "name": "Pedidos"
    },
    {
      "name": "Autenticación"
    }
  ],
  "paths": {
    "/clientes": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Listar clientes",
        "description": "Filtros opcionales, siempre parametrizados (ADR-004).",
        "parameters": [
          {
            "name": "ciudad",
            "in": "query",
            "required": false,
            "description": "Ciudad (contiene)",
            "schema": {
              "type": "string"
            },
            "example": "Medellín"
          },
          {
            "name": "nombre",
            "in": "query",
            "required": false,
            "description": "Nombre (contiene)",
            "schema": {
              "type": "string"
            },
            "example": "Ana"
          },
          {
            "name": "correo",
            "in": "query",
            "required": false,
            "description": "Correo (contiene)",
            "schema": {
              "type": "string"
            },
            "example": "gmail"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de clientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cliente"
                  }
                },
                "example": [
                  {
                    "id": 21,
                    "nombre_cliente": "Ana Pérez",
                    "telefono": "3001234567",
                    "correo": "ana.perez@gmail.com",
                    "direccion": "Cra 50 #20-10",
                    "ciudad": "Medellín",
                    "fecha_registro": "2026-11-04"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Error del servidor o de la base de datos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to connect to localhost:1433"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Crear cliente",
        "description": "Valida nombre, correo y teléfono (ADR-005) y que el correo no esté repetido.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteEntrada"
              },
              "example": {
                "nombre_cliente": "Ana Pérez",
                "telefono": "3001234567",
                "correo": "ana.perez@gmail.com",
                "direccion": "Cra 50 #20-10",
                "ciudad": "Medellín"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                },
                "example": {
                  "id": 21,
                  "nombre_cliente": "Ana Pérez",
                  "telefono": "3001234567",
                  "correo": "ana.perez@gmail.com",
                  "direccion": "Cra 50 #20-10",
                  "ciudad": "Medellín",
                  "fecha_registro": "2026-11-04"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (ADR-005)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Datos inválidos: el nombre del cliente es obligatorio"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor o de la base de datos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to connect to localhost:1433"
                }
              }
            }
          }
        }
      }
    },
    "/clientes/{id}": {
