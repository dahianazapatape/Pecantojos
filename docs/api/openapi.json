          "Clientes"
        ],
        "summary": "Obtener un cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del recurso",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
